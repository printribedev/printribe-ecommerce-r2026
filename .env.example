# Supabase (new project for the storefront, NOT the CRM's)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (Supabase -> Settings -> Database). DATABASE_URL = pooled, DIRECT_URL = direct.
DATABASE_URL=
DIRECT_URL=

# First admin(s): these emails become ADMIN when they first sign in (comma-separated)
ADMIN_EMAILS=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
# Public base URL of the public bucket (custom domain or r2.dev URL)
R2_PUBLIC_URL=

# Razorpay (phase 5)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (phase 7). Use onboarding@resend.dev until printribe.in DNS is verified.
RESEND_API_KEY=
EMAIL_FROM=Printribe <noreply@printribe.in>

# CRM hand-off (phase 6)
CRM_BASE_URL=
CRM_INTAKE_SECRET=
